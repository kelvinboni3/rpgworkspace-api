# Copiar para .env (na mesma pasta) e preencher. O .env NUNCA vai para o git.

# Domínio do produto, sem https:// e sem barra (ex.: rpgworkspace.com.br)
DOMAIN=

# Senha do Postgres do container (gerar: openssl rand -base64 24)
POSTGRES_PASSWORD=

# Segredo JWT, 32+ chars (gerar: openssl rand -base64 48)
JWT_SECRET=

# Chave da API da Anthropic (IA de estruturação de notas)
ANTHROPIC_API_KEY=

# Chave da API do Resend (e-mail de reset de senha)
RESEND_API_KEY=

# Remetente dos e-mails. Até o domínio ser verificado no Resend (fase 3),
# só onboarding@resend.dev funciona — e entrega apenas para o dono da conta.
RESEND_FROM_EMAIL=onboarding@resend.dev
