{$DOMAIN} {
	encode gzip

	# API e front na mesma origem — o /api do front funciona sem CORS cross-origin.
	handle /api/* {
		reverse_proxy api:8080
	}

	# Health checks (deploy.sh e UptimeRobot).
	handle /health/* {
		reverse_proxy api:8080
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	# Assets com hash no nome nunca mudam; o resto precisa revalidar para o PWA atualizar.
	@immutable path /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	@nocache path /sw.js /index.html /manifest.webmanifest
	header @nocache Cache-Control "no-cache"
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
